# Secrets are injected via environment variables, never committed.
# Copy to .env and fill in.

# Telegram bot (required for briefing delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reddit OAuth app (script type, read-only)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GitHub read-only PAT
GITHUB_TOKEN=

# LLM provider
OPENAI_API_KEY=
